# ── SMTP settings ────────────────────────────────────────────────────────────
# Gmail: use an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="WhatsApp Monitor <your-email@gmail.com>"

# Outlook / Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ── Report destination ────────────────────────────────────────────────────────
REPORT_EMAIL=recipient@example.com

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Hong_Kong

# ── Scan limits ───────────────────────────────────────────────────────────────
MESSAGE_HISTORY_LIMIT=10
SCAN_CONCURRENCY=20

# ── Anthropic API key ─────────────────────────────────────────────────────────
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...
# claude-haiku-4-5-20251001 = faster + cheaper; use claude-sonnet-4-6 for more accuracy
CLAUDE_MODEL=claude-haiku-4-5-20251001
CONFIDENCE_THRESHOLD=0.7

# ── Assignee mapping ──────────────────────────────────────────────────────────
DEFAULT_ASSIGNEE=未指派
# JSON: keyword (substring of group name, case-insensitive) → assignee name
ASSIGNEE_MAP={"POS":"Alvin","ERP":"Ken","客服":"Mary"}

# ── Colleague names (treated as agent-side, same as fromMe) ───────────────────
COLLEAGUE_NAMES=Jack,Support3,Sherry

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron schedule (default: top of every hour)
CRON_SCHEDULE=0 * * * *

# ── Next.js server port ───────────────────────────────────────────────────────
PORT=3000

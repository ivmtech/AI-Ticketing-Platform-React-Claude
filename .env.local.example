# ── Secrets template — copy to .env.local and fill in ────────────
# .env.local is git-ignored; this example IS committed so new setups
# know which secrets are required. Non-sensitive config lives in .env.

# ── SMTP settings ─────────────────────────────────────────────────
# Gmail / Google Workspace — use an App Password, not your login password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# ── Report destination ────────────────────────────────────────────
REPORT_EMAIL=recipient1@example.com,recipient2@example.com
SMTP_FROM="WhatsApp Monitor <you@example.com>"

# ── Anthropic API key (for Claude resolution analysis) ───────────
ANTHROPIC_API_KEY=sk-ant-api03-...

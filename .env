# ── Non-sensitive configuration (safe to commit) ─────────────────
# Secrets — SMTP credentials, recipient emails, and the Anthropic API
# key — live in .env.local, which is git-ignored. Next.js auto-loads
# both and merges them, with .env.local taking precedence.

# ── Timezone for the scheduled reports ───────────────────────────
TZ=Asia/Hong_Kong
# Run at 9:00 AM, 10:00 AM and 5:00 PM Hong Kong time
# Multiple schedules separated by ; (standard cron can't mix different minutes in one expression)
CRON_SCHEDULE=0 9,14 * * *;

# ── Scan limits (optional) ────────────────────────────────────────
# Stop scanning after this many minutes and send a partial report (default: 8)
SCAN_TIMEOUT_MINUTES=8
# Stop after this many groups-with-activity are found (0 = unlimited)
SCAN_LIMIT=0
# Max messages per group fed to Claude (smaller = faster, default: 20)
MESSAGE_HISTORY_LIMIT=20
# How many groups to analyze in parallel (default: 5)
SCAN_CONCURRENCY=5
# How far back to scan, in hours (default: 168 = 7 days)
SCAN_LOOKBACK_HOURS=168

# ── Colleague display names (comma-separated) ────────────────────
# Messages from these names are treated as agent messages (same as fromMe)
COLLEAGUE_NAMES=IvmVending_Jack,售賣機客戶服務,Support3,Rex (IVM),IVM Sherry,IVM Technology,Leo Lui,(Ivm Workphone) Jack,Kathy,Ken,SherryShum,Ivm Cs,補貨司機

# ── LID → display name (comma-separated "id:Name" pairs) ─────────
# WhatsApp addresses many group members by LID (`<lid>@lid`) instead of by
# phone number. A LID carries no phone number and these senders often have no
# WhatsApp display name, so the report used to print the bare id — e.g.
# 182038447571092 — and it could never match COLLEAGUE_NAMES above. Map the id
# to a name here; add that name to COLLEAGUE_NAMES too if the person is staff.
# 182038447571092 = the restock driver who posts 「今天黎補貨，幫手報車牌」.
LID_NAMES=182038447571092:補貨司機
# Other unnamed LIDs seen in the 18/8/2026 report — fill in and uncomment:
#   130086019833871 (12 rows), 144117694734398 (2), 7946394193984,
#   53197481717852, 277927434391611, 142855511216282, 135214797983908

# ── Display label for messages sent by this WhatsApp account (fromMe) ────
# Must match one of the COLLEAGUE_NAMES above so it gets blue styling
AGENT_LABEL=售賣機客戶服務

# ── Claude model (haiku = faster + cheaper, opus = more accurate) ─
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Below this confidence (0-1), entry is auto-routed to 待跟進 with 需人手覆核 tag
CONFIDENCE_THRESHOLD=0.8
